# Supabase — get these from your project's Settings → API
# Copy this file to .env.local (gitignored) and paste real values.
# On Vercel, set these as Environment Variables on the project.

VITE_SUPABASE_URL=https://srodxtdiiyclawkiucsy.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: force the app to use fixtures even if the URL/key are set.
# Useful for local development against the demo data.
# VITE_USE_FIXTURES=true

# --- Botscrew embed: server-side JWT verification (strict mode; added next) ---
# Shared HS256 secret with Botscrew's GET /api/private/analytics-token endpoint.
# 32+ random chars. Server-only — never prefix with VITE_ (would ship in the bundle).
BOTSCREW_TOKEN_SECRET=
# Admin key guarding master-scope prompt writes (api/prompt.ts scope=master).
GSB_ADMIN_KEY=
# soft  = requests without a Bearer token behave as today (password-gate world keeps working)
# strict = 401 without a valid token. Flip to strict once Botscrew's token endpoint ships.
EMBED_AUTH_MODE=soft

# --- Voice recordings: server-side Twilio proxy (/api/recording) ---
# GSB owns the Twilio account behind voice AI. Server-only — NEVER prefix with VITE_.
# Bot 248 lives on account AC9271…; the 461-495 voice fleet is a second account
# (per-bot account map is a follow-up). Get these from the Twilio Console → Account Info.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
