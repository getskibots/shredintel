# ─── Botscrew MySQL (read-only) ──────────────────────────────
# Same values you use in MySQL Workbench.
BOTSCREW_MYSQL_HOST=
BOTSCREW_MYSQL_PORT=3306
BOTSCREW_MYSQL_USER=
BOTSCREW_MYSQL_PASSWORD=
BOTSCREW_MYSQL_DATABASE=

# ─── GSB Supabase (destination) ──────────────────────────────
# RECOMMENDED: discrete fields (no URL-encoding needed — paste the raw
# password even if it has @ # : / etc). Values come from the Session pooler
# connection string (Supabase -> Connect -> Direct -> Session pooler).
SUPABASE_DB_HOST=aws-1-us-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.srodxtdiiyclawkiucsy
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# ── OR, alternatively, a full connection string (special chars must be
#    URL-encoded). Leave the discrete fields above blank if you use this.
# SUPABASE_DB_URL=postgresql://postgres.srodxtdiiyclawkiucsy:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres

# ─── Sync tuning (optional) ──────────────────────────────────
# Rows pulled per batch. 5000 is safe. Lower if memory-constrained.
BATCH_SIZE=5000
